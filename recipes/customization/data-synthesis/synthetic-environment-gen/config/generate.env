# Settings for TMax's generation launcher, rl_data/scripts/generate_tasks/run_generate_tasks.sh,
# which reads every one of these from the environment. run_all.sh loads this file; a value already set
# in the shell wins, so `NUM_TASKS=10 bash run_all.sh` works.
NUM_TASKS=100                 # tasks to sample; about 80 % build and about 55 % of those are solved by Beam
OUT_DIR=output/tasks
MODEL=reflection/Beam-1.0-501B-A23B   # provider/model; the Reflection API serves Beam-1.0-501B-A23B
CORPUS_KIND=rl_v2             # legacy | sft_v2 | rl_v2  (TMax sampling axes; rl_v2 = all verifier and fixture kinds)
MAX_TOKENS=65536              # generation output budget; task templates and verifiers can be long
BATCH_SIZE=100
MAX_CONCURRENCY=16            # parallel API requests in stages 1-4
DEF_BUILD_WORKERS=4           # parallel container builds in stage 5; each needs ~1 CPU and ~4 GB
TASK_TEMPERATURE=1.0
TEST_TEMPERATURE=0.6
